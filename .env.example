# Copy to .env (git-ignored) and fill in. sma reads it when it starts; a variable already set in the shell wins.
HF_TOKEN=
# Where weights are cached. It goes into run records, so keep it outside a home folder named after the host.
SMA_HF_CACHE_DIR=

# Lab machines for KernelBench and SWE-bench. SMA scrubs these values from run records and writes
# ${NAME} instead, as the baseline READMEs under runs/ do.
# This machine, where SMA serves models, and the model server's port the SWE-bench runner reaches.
SMA_HOST=
SMA_MODEL_PORT=
# KernelBench service (runs/gb10/baseline/kernelbench/README.md).
KERNELBENCH_URL=
KERNELBENCH_HOST=
KERNELBENCH_GPU_PCI=
# SWE-bench runner, an x86_64 Docker host reached over SSH (runs/cpu/baseline/sweverified/README.md).
SWE_RUNNER_HOST=
SWE_RUNNER_USER=
SWE_RUNNER_SSH_KEY=
# The tailnet these names resolve in.
TAILNET_DOMAIN=
# The judge. Since 2026-11-04 it is Qwen 3.8 Flash on OpenRouter (browsecomp.judge_url and judge_model in
# sma.yaml), with this key; SMA scrubs it from records.
OPENROUTER_KEY=
# A lab judge instead: an OpenAI-compatible endpoint (for example a LiteLLM proxy) and its key, used when
# browsecomp.judge_url is empty and judge_key_env is SMA_JUDGE_API_KEY. SMA scrubs the URL from records and
# never writes the key.
SMA_JUDGE_URL=
SMA_JUDGE_API_KEY=
# Private names (repos, machines, projects) that must never be published, comma-separated. sma publish-check
# and the pre-push hook refuse any file that holds one; the list itself stays here, out of git.
SMA_PUBLISH_DENY=

# The V100 serving pod, reached over SSH (services/v100-serving/README.md). SMA scrubs V100_HOST from
# records; the model ports are inside the pod.
V100_HOST=
V100_HOST_USER=
V100_HOST_SSH_PORT=
V100_HOST_SSH_KEY=
V100_MODEL1_PORT=
V100_MODEL2_PORT=
V100_MODEL3_PORT=
V100_MODEL4_PORT=
