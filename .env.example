# Copy to .env (git-ignored) and fill in. sma reads it when it starts; a variable already set in the shell wins.
HF_TOKEN=
# Where weights are cached. It goes into run records, so keep it outside a home folder named after the host.
SMA_HF_CACHE_DIR=

# Lab machines for KernelBench and SWE-bench. SMA scrubs these values from run records and writes
# ${NAME} instead, as the baseline READMEs under runs/ do.
# This machine, where SMA serves models, and the model server's port the SWE-bench runner reaches.
SMA_HOST=
SMA_MODEL_PORT=
# KernelBench service (runs/gb10/baseline/kernelbench/README.md).
KERNELBENCH_URL=
KERNELBENCH_HOST=
KERNELBENCH_GPU_PCI=
# SWE-bench runner, an x86_64 Docker host reached over SSH (runs/cpu/baseline/sweverified/README.md).
SWE_RUNNER_HOST=
SWE_RUNNER_USER=
SWE_RUNNER_SSH_KEY=
# The tailnet these names resolve in.
TAILNET_DOMAIN=
