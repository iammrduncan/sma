# KernelBench evaluation service (README.md): KernelBench at a pinned commit, PyTorch 2.9.1
# (KernelBench's torch==2.9.*) with the matching nvcc (KernelBench compiles each kernel with torch's
# load_inline), plus this folder's server, worker and sandbox (standard-library Python).
#
# The defaults build for a DGX Spark's GB10 (arm64, compute capability 12.1): CUDA 13.0, because
# nvcc 12.8 can't build for sm_121. For an x86_64 card that CUDA 12.8 supports, pass the CUDA 12.8
# base and wheel index (README.md, "Other GPUs").
#
# Only what evaluation imports is installed, plus einops, which Level 3's Mamba2 problems (48, 49)
# import (the problems need nothing else beyond torch and the standard library). KernelBench's utils
# also import LiteLLM and the OpenAI client at load time, for generation, which this service never
# does: stubs/ takes their names, so no model client is installed in an image that runs
# model-written code.
ARG BASE_IMAGE=docker.io/nvidia/cuda:13.0.2-devel-ubuntu24.04@sha256:5dc1bca23d05bd37b011be68ec470c03b403a5da07ec3a86e41af9470e9d0cc6
FROM $BASE_IMAGE

ARG KERNELBENCH_COMMIT=423217d9fda91e0c2d67e4a43bf62f96f6d104f1
# PyTorch's wheel index for the base's CUDA (cu130, cu128).
ARG TORCH_CUDA=cu130
ENV DEBIAN_FRONTEND=noninteractive

# The base's ca-certificates trusted the compromised eMudhra chain and its libbrotli1 had
# CVE-2026-111497 (2026-10): take the distribution's fixed packages.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv python3-dev git ca-certificates \
 && apt-get install -y --no-install-recommends --only-upgrade ca-certificates libbrotli1 \
 && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/ScalingIntelligence/KernelBench.git /opt/kernelbench \
 && git -C /opt/kernelbench checkout --quiet --detach "$KERNELBENCH_COMMIT" \
 && test "$(git -C /opt/kernelbench rev-parse HEAD)" = "$KERNELBENCH_COMMIT" \
 && echo "$KERNELBENCH_COMMIT" > /opt/kernelbench/COMMIT \
 && rm -rf /opt/kernelbench/.git /opt/kernelbench/notebooks /opt/kernelbench/assets /opt/kernelbench/results

RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir "pip==25.2" \
 && /opt/venv/bin/pip install --no-cache-dir --index-url "https://download.pytorch.org/whl/$TORCH_CUDA" "torch==2.9.1" \
 && /opt/venv/bin/pip install --no-cache-dir "numpy==2.3.5" "einops==0.8.1" "pydantic==2.12.5" "requests==2.32.5" \
      "python-dotenv==1.2.1" "tqdm==4.67.1" "ninja==1.13.0" "packaging==25.0" "setuptools==80.9.0" \
 && /opt/venv/bin/pip freeze > /opt/kernelbench-eval-pip.txt \
 && ! grep -i -E '^(litellm|openai)==' /opt/kernelbench-eval-pip.txt

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/opt/kernelbench/src:/opt/kernelbench-eval/stubs \
    KERNELBENCH_DIR=/opt/kernelbench \
    KERNELBENCH_COMMIT=$KERNELBENCH_COMMIT \
    PYTHONDONTWRITEBYTECODE=1

COPY server.py worker.py sandbox.py /opt/kernelbench-eval/
COPY stubs/ /opt/kernelbench-eval/stubs/
# The state folder belongs to the service's user, so a new Docker volume mounted there starts out
# writable by it.
RUN chmod -R a+rX,go-w /opt/kernelbench-eval \
 && install -d -o 10001 -g 10001 -m 0750 /var/lib/kernelbench \
 && python -c "import kernelbench.eval, kernelbench.timing, kernelbench.dataset, torch; \
print('kernelbench', open('/opt/kernelbench/COMMIT').read().strip(), 'torch', torch.__version__, torch.version.cuda)"

USER 10001
WORKDIR /tmp
ENTRYPOINT ["python", "-u", "/opt/kernelbench-eval/server.py"]
