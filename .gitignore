.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
*.egg-info/
# Machine settings and secrets: the HF token and the cache path (.env.example lists them).
.env
# Run records are committed: they are the data SMA submits (owner decision 2026-10-27).
# These stay out: machine names, the catalog SMA rebuilds from the manifests, and files
# too big for git (records.LARGE_FILES; each manifest keeps their sha256 and size).
runs/catalog.sqlite
runs/index.json
runs/.catalog.lock
runs/**/logprobs/dump.json
runs/**/logprobs/kld-base.bin
runs/**/quality/swebench_verified_mini/trajectories.jsonl.gz
# BrowseComp-Plus's questions and answers must never be published as plain text: the bundle and the
# per-question files that become it hold them.
runs/**/quality/browsecomp_plus/trajectories.jsonl.gz
runs/**/quality/browsecomp_plus/queries/
# Harness caches inside a suite's attempt: BFCL's request and response stores (SQLite, with their -wal
# and -shm journals) and LiveCodeBench's answer cache. The answers are in the suite's own result files.
runs/**/quality/*/attempt-*/cache/
runs/**/quality/*/attempt-*/response_stats_cache/
*.db-wal
*.db-shm
# A llama-server log too big for git (957 MB of prompt-cache bookkeeping); it stays on this machine.
runs/LiquidAI_LFM3-1.7B-GGUF/llamacpp/gguf-QAD-Q4_0/20261029T233424Z-3514e934/logs/server-quality.log
queue/
.sma/
*.tmp
.coverage
htmlcov/
# uv sync creates it. It is not committed unless the owner asks (AGENTS.md).
uv.lock
# Claude Code's per-user settings, which can hold local paths.
.claude/settings.local.json
