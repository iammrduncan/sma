{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sma.local/schemas/summary.schema.json",
  "title": "SMA run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model_repo",
    "model_slug",
    "quant_flag",
    "quant_label",
    "quant_detected",
    "revision_sha",
    "host_alias",
    "engine",
    "engine_image",
    "engine_image_digest",
    "status",
    "determinism_passed",
    "batch_invariant",
    "perplexity",
    "perplexity_tokens",
    "kl_mean",
    "kl_method",
    "kl_k",
    "top1_agreement",
    "delta_ppl",
    "reference_run_id",
    "quality",
    "speed",
    "energy",
    "thermal",
    "params_total",
    "params_active",
    "params_total_b",
    "params_active_b",
    "size_class",
    "deployment",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string" },
    "model_repo": { "type": "string" },
    "model_slug": { "type": "string" },
    "quant_flag": { "enum": ["bf16", "nvfp4", "mxfp4", "mixed", "gguf"] },
    "quant_label": { "type": ["string", "null"] },
    "thinking": {
      "description": "The run's thinking mode. Null: a run from before the setting, which scored quality with thinking off.",
      "enum": ["off", "on", null]
    },
    "quant_detected": { "type": ["string", "null"] },
    "revision_sha": { "type": ["string", "null"] },
    "host_alias": { "type": "string" },
    "engine": { "enum": ["vllm", "sglang", "llamacpp"] },
    "engine_image": { "type": "string" },
    "engine_image_digest": { "type": ["string", "null"] },
    "status": { "enum": ["pending", "running", "done", "failed"] },
    "determinism_passed": { "type": ["boolean", "null"] },
    "batch_invariant": { "type": "boolean" },
    "perplexity": { "type": ["number", "null"] },
    "perplexity_tokens": { "type": ["integer", "null"] },
    "kl_mean": { "type": ["number", "null"] },
    "kl_method": { "type": ["string", "null"] },
    "kl_k": { "type": ["integer", "null"] },
    "top1_agreement": { "type": ["number", "null"] },
    "delta_ppl": { "type": ["number", "null"] },
    "reference_run_id": { "type": ["string", "null"] },
    "quality": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/suite" }
    },
    "speed": { "$ref": "#/$defs/speed" },
    "energy": { "$ref": "#/$defs/energy" },
    "thermal": { "$ref": "#/$defs/thermal" },
    "params_total": { "type": ["integer", "null"] },
    "params_active": { "type": ["integer", "null"] },
    "params_total_b": { "type": ["number", "null"] },
    "params_active_b": { "type": ["number", "null"] },
    "size_class": { "type": ["string", "null"] },
    "deployment": { "$ref": "#/$defs/deployment" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentence", "engine", "weight_format", "kv_cache_type", "context_per_stream", "context_reason", "computed", "measured"],
      "properties": {
        "sentence": { "type": ["string", "null"] },
        "engine": { "enum": ["vllm", "sglang", "llamacpp"] },
        "weight_format": { "type": ["string", "null"] },
        "kv_cache_type": { "type": ["string", "null"] },
        "context_per_stream": { "type": ["integer", "null"] },
        "context_reason": { "type": ["string", "null"] },
        "computed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weights_gb", "kv_bytes_per_token", "kv_pool_gb", "kv_pool_tokens", "streams_full_context", "streams_32k", "planned_footprint_gb", "memory_budget_gb"],
          "properties": {
            "weights_gb": { "type": ["number", "null"] },
            "kv_bytes_per_token": { "type": ["integer", "null"] },
            "kv_pool_gb": { "type": ["number", "null"] },
            "kv_pool_tokens": { "type": ["integer", "null"] },
            "streams_full_context": { "type": ["integer", "null"] },
            "streams_32k": { "type": ["integer", "null"] },
            "planned_footprint_gb": { "type": ["number", "null"] },
            "memory_budget_gb": { "type": ["number", "null"] }
          }
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kv_pool_tokens", "streams_full_context", "streams_32k", "peak_memory_gb", "output_tok_s_c1", "output_tok_s_c4", "output_tok_s_c8"],
          "properties": {
            "kv_pool_tokens": { "type": ["integer", "null"] },
            "streams_full_context": { "type": ["integer", "null"] },
            "streams_32k": { "type": ["integer", "null"] },
            "peak_memory_gb": { "type": ["number", "null"] },
            "output_tok_s_c1": { "type": ["number", "null"] },
            "output_tok_s_c4": { "type": ["number", "null"] },
            "output_tok_s_c8": { "type": ["number", "null"] }
          }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "metric", "scorer", "limit", "n", "ci_lower", "ci_upper", "context_per_stream", "error"],
      "properties": {
        "context_per_stream": { "type": ["integer", "null"] },
        "score": { "type": ["number", "null"] },
        "metric": { "type": ["string", "null"] },
        "scorer": { "type": "string" },
        "limit": { "type": ["integer", "null"] },
        "n": { "type": ["integer", "null"] },
        "ci_lower": { "type": ["number", "null"] },
        "ci_upper": { "type": ["number", "null"] },
        "error": { "type": ["string", "null"] },
        "measures": {
          "description": "Each measure the harness reported besides the headline, as a share (IFEval: by prompt and by instruction, strict and loose). Null when it reported none. Older records lack it.",
          "type": ["object", "null"],
          "additionalProperties": { "type": "number" }
        },
        "answers_cut_off": {
          "description": "Answers that stopped at the output limit (finish_reason length). Null when not counted.",
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "shape",
        "concurrency",
        "input_len",
        "output_len",
        "repeat",
        "attempt",
        "valid",
        "validity",
        "invalid_reason",
        "invalidation_reason",
        "measurement_note",
        "ttft_ms_p50",
        "ttft_ms_p90",
        "ttft_ms_p99",
        "tpot_ms_p50",
        "tpot_ms_p90",
        "tpot_ms_p99",
        "itl_ms_p50",
        "itl_ms_p90",
        "itl_ms_p99",
        "e2el_ms_p50",
        "e2el_ms_p90",
        "e2el_ms_p99",
        "output_tok_s",
        "prefill_tok_s",
        "decode_tok_s"
      ],
      "properties": {
        "name": { "type": "string" },
        "shape": { "type": "string" },
        "concurrency": { "type": "integer" },
        "input_len": { "type": "integer" },
        "output_len": { "type": "integer" },
        "repeat": { "type": "integer" },
        "attempt": { "type": "integer" },
        "valid": { "type": "boolean" },
        "validity": { "enum": ["valid", "invalid", "unverified"] },
        "invalid_reason": { "type": ["string", "null"] },
        "invalidation_reason": {
          "type": ["string", "null"],
          "enum": ["bench_failed", "telemetry_gap", "throttled", null]
        },
        "measurement_note": { "type": ["string", "null"] },
        "ttft_ms_p50": { "type": ["number", "null"] },
        "ttft_ms_p90": { "type": ["number", "null"] },
        "ttft_ms_p99": { "type": ["number", "null"] },
        "tpot_ms_p50": { "type": ["number", "null"] },
        "tpot_ms_p90": { "type": ["number", "null"] },
        "tpot_ms_p99": { "type": ["number", "null"] },
        "itl_ms_p50": { "type": ["number", "null"] },
        "itl_ms_p90": { "type": ["number", "null"] },
        "itl_ms_p99": { "type": ["number", "null"] },
        "e2el_ms_p50": { "type": ["number", "null"] },
        "e2el_ms_p90": { "type": ["number", "null"] },
        "e2el_ms_p99": { "type": ["number", "null"] },
        "output_tok_s": { "type": ["number", "null"] },
        "prefill_tok_s": { "type": ["number", "null"] },
        "decode_tok_s": { "type": ["number", "null"] }
      }
    },
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefill_tok_s",
        "prefill_tok_s_stat",
        "decode_tok_s",
        "decode_tok_s_stat",
        "output_tok_s_c4",
        "output_tok_s_c8",
        "invalid_cells",
        "unverified_cells",
        "bandwidth_ceiling_tok_s",
        "bandwidth_ceiling_note",
        "cells"
      ],
      "properties": {
        "prefill_tok_s": { "type": ["number", "null"] },
        "prefill_tok_s_stat": { "type": "string" },
        "decode_tok_s": { "type": ["number", "null"] },
        "decode_tok_s_stat": { "type": "string" },
        "output_tok_s_c4": { "type": ["number", "null"] },
        "output_tok_s_c8": { "type": ["number", "null"] },
        "invalid_cells": { "type": "integer", "minimum": 0 },
        "unverified_cells": { "type": "integer", "minimum": 0 },
        "bandwidth_ceiling_tok_s": { "type": ["number", "null"] },
        "bandwidth_ceiling_note": { "type": "string" },
        "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
      }
    },
    "energy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["joules", "joules_per_bench_request", "method", "sample_hz", "scope", "note"],
      "properties": {
        "joules": { "type": ["number", "null"] },
        "joules_per_bench_request": { "type": ["number", "null"] },
        "method": { "type": "string" },
        "sample_hz": { "type": "number" },
        "scope": { "enum": ["gpu"] },
        "note": { "type": "string" }
      }
    },
    "thermal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temp_start_c", "temp_end_c", "throttle_samples", "clock_cap_mhz", "sw_power_cap_invalidates", "log"],
      "properties": {
        "temp_start_c": { "type": ["number", "null"] },
        "temp_end_c": { "type": ["number", "null"] },
        "throttle_samples": { "type": "integer", "minimum": 0 },
        "clock_cap_mhz": { "type": ["integer", "null"] },
        "sw_power_cap_invalidates": { "type": "boolean" },
        "log": { "type": "string" }
      }
    }
  }
}
