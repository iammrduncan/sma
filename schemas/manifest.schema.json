{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sma.local/schemas/manifest.schema.json",
  "title": "SMA run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model_repo",
    "model_slug",
    "revision_requested",
    "revision_sha",
    "quant_flag",
    "quant_label",
    "quant_detected",
    "quant_detail",
    "quant_producer",
    "quant_composition",
    "architecture_check",
    "architecture",
    "architectures",
    "is_moe",
    "params",
    "file_hashes",
    "tokenizer_fingerprint",
    "subject",
    "engine",
    "sma_version",
    "sma_git_commit",
    "sma_git_dirty",
    "host_alias",
    "timestamps",
    "steps",
    "warnings",
    "reference_run_id",
    "pair_job_id",
    "dispatch_concurrency",
    "config_snapshot",
    "memory_plan",
    "gguf",
    "logprobs_reference_file"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "model_repo": { "type": "string", "minLength": 1 },
    "model_slug": { "type": "string", "minLength": 1 },
    "revision_requested": { "type": ["string", "null"] },
    "revision_sha": { "type": ["string", "null"] },
    "quant_flag": { "enum": ["bf16", "nvfp4", "mxfp4", "mixed", "gguf"] },
    "quant_label": { "type": ["string", "null"] },
    "quant_detected": { "type": ["string", "null"] },
    "quant_detail": { "type": ["string", "null"] },
    "quant_producer": { "type": ["string", "null"] },
    "quant_composition": { "type": ["object", "null"] },
    "architecture_check": { "type": ["object", "null"] },
    "architecture": { "type": ["string", "null"] },
    "architectures": { "type": "array", "items": { "type": "string" } },
    "is_moe": { "type": ["boolean", "null"] },
    "params": { "$ref": "#/$defs/params" },
    "file_hashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "tokenizer_fingerprint": { "type": ["string", "null"] },
    "subject": { "$ref": "#/$defs/subject" },
    "engine": { "$ref": "#/$defs/engine" },
    "sma_version": { "type": "string" },
    "sma_git_commit": { "type": ["string", "null"] },
    "sma_git_dirty": { "type": "boolean" },
    "host_alias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
    "timestamps": { "$ref": "#/$defs/timestamps" },
    "steps": { "$ref": "#/$defs/steps" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "reference_run_id": { "type": ["string", "null"] },
    "pair_job_id": { "type": ["string", "null"] },
    "dispatch_concurrency": { "type": "integer", "minimum": 1 },
    "config_snapshot": { "type": "object" },
    "memory_plan": { "type": ["object", "null"] },
    "gguf": { "type": ["object", "null"] },
    "logprobs_reference_file": { "type": ["string", "null"] }
  },
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "active", "total_b", "active_b", "size_class", "method", "source"],
      "properties": {
        "total": { "type": ["integer", "null"], "minimum": 0 },
        "active": { "type": ["integer", "null"], "minimum": 0 },
        "total_b": { "type": ["number", "null"] },
        "active_b": { "type": ["number", "null"] },
        "size_class": { "type": ["string", "null"] },
        "method": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_repo", "revision_sha", "quant", "engine", "hardware_alias"],
      "properties": {
        "model_repo": { "type": "string" },
        "revision_sha": { "type": ["string", "null"] },
        "quant": { "type": "string" },
        "engine": { "enum": ["vllm", "sglang", "llamacpp"] },
        "hardware_alias": { "type": "string" }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "selected_by",
        "selection_reason",
        "build_info",
        "bench_image",
        "kv_cache_type",
        "kv_cache_scales",
        "kv_cache_reported",
        "context_per_stream",
        "image",
        "image_digest",
        "tensor_parallel_size",
        "moe_backend_config",
        "moe_backend_chain",
        "moe_backend_used",
        "moe_backend_fallback",
        "moe_backend_quality",
        "moe_backend_speed",
        "moe_backend_quality_fallback",
        "moe_backend_speed_fallback",
        "linear_backend",
        "batch_invariant_quality",
        "batch_invariant_supported",
        "batch_invariant_warning",
        "flashinfer_autotune_quality",
        "no_async_scheduling_quality",
        "seed",
        "max_logprobs",
        "logprobs_mode",
        "flags_quality",
        "flags_speed",
        "env_quality",
        "env_speed",
        "clock_cap_mhz",
        "resolved_backend_note",
        "deterministic_quality",
        "tool_call_parser"
      ],
      "properties": {
        "name": { "enum": ["vllm", "sglang", "llamacpp"] },
        "selected_by": { "enum": ["format", "flag", "default", "preflight"] },
        "selection_reason": { "type": ["string", "null"] },
        "build_info": { "type": ["string", "null"] },
        "bench_image": { "type": ["string", "null"] },
        "kv_cache_type": { "enum": ["fp8", "q8_0"] },
        "kv_cache_scales": { "type": ["string", "null"] },
        "kv_cache_reported": { "type": "object" },
        "context_per_stream": { "type": ["integer", "null"], "minimum": 1 },
        "tool_call_parser": { "type": ["string", "null"] },
        "image": { "type": "string" },
        "image_digest": { "type": ["string", "null"] },
        "tensor_parallel_size": { "const": 1 },
        "moe_backend_config": { "type": "string" },
        "moe_backend_chain": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "moe_backend_used": { "type": ["string", "null"] },
        "moe_backend_fallback": { "type": "boolean" },
        "moe_backend_quality": { "type": ["string", "null"] },
        "moe_backend_speed": { "type": ["string", "null"] },
        "moe_backend_quality_fallback": { "type": "boolean" },
        "moe_backend_speed_fallback": { "type": "boolean" },
        "linear_backend": { "type": ["string", "null"] },
        "batch_invariant_quality": { "type": "boolean" },
        "batch_invariant_supported": { "type": ["boolean", "null"] },
        "batch_invariant_warning": { "type": ["string", "null"] },
        "flashinfer_autotune_quality": { "type": "boolean" },
        "no_async_scheduling_quality": { "type": "boolean" },
        "seed": { "type": "integer" },
        "max_logprobs": { "type": "integer", "minimum": 1 },
        "logprobs_mode": { "type": "string" },
        "flags_quality": { "type": "array", "items": { "type": "string" } },
        "flags_speed": { "type": "array", "items": { "type": "string" } },
        "env_quality": { "type": "object", "additionalProperties": { "type": "string" } },
        "env_speed": { "type": "object", "additionalProperties": { "type": "string" } },
        "clock_cap_mhz": { "type": ["integer", "null"] },
        "resolved_backend_note": { "type": ["string", "null"] },
        "deterministic_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefix_cache", "attention_backend", "determinism_backend", "radix_cache"],
          "properties": {
            "prefix_cache": { "type": "boolean" },
            "attention_backend": { "type": ["string", "null"] },
            "determinism_backend": { "type": ["string", "null"] },
            "radix_cache": { "type": ["boolean", "null"] }
          }
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "started", "finished"],
      "properties": {
        "created": { "type": "string" },
        "started": { "type": ["string", "null"] },
        "finished": { "type": ["string", "null"] }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "started", "finished", "error", "attempts"],
      "properties": {
        "status": { "enum": ["pending", "running", "done", "failed", "skipped"] },
        "started": { "type": ["string", "null"] },
        "finished": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] },
        "attempts": { "type": "integer", "minimum": 0 }
      }
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fetch",
        "serve_quality",
        "determinism",
        "logprobs",
        "quality",
        "serve_speed",
        "speed",
        "telemetry",
        "teardown",
        "cleanup"
      ],
      "properties": {
        "fetch": { "$ref": "#/$defs/step" },
        "serve_quality": { "$ref": "#/$defs/step" },
        "determinism": { "$ref": "#/$defs/step" },
        "logprobs": { "$ref": "#/$defs/step" },
        "quality": { "$ref": "#/$defs/step" },
        "serve_speed": { "$ref": "#/$defs/step" },
        "speed": { "$ref": "#/$defs/step" },
        "telemetry": { "$ref": "#/$defs/step" },
        "teardown": { "$ref": "#/$defs/step" },
        "cleanup": { "$ref": "#/$defs/step" }
      }
    }
  }
}
